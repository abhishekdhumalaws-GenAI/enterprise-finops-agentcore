from fastapi import FastAPI
from pydantic import BaseModel

from backend.agents.coordinator_agent import FinOpsCoordinatorAgent
from backend.agents.cost_explorer_agent import CostExplorerAgent
from backend.services.cost_summary_service import CostSummaryService

app = FastAPI(title="Enterprise FinOps AgentCore API")

coordinator = FinOpsCoordinatorAgent()
cost_agent = CostExplorerAgent()
summary_service = CostSummaryService()


class FinOpsRequest(BaseModel):
    user_query: str


@app.get("/")
def health_check():
    return {
        "status": "running",
        "service": "Enterprise FinOps AgentCore API"
    }


@app.post("/analyze")
def analyze_cost(request: FinOpsRequest):
    routing_decision = coordinator.analyze_request(request.user_query)

    service_filter = None

if routing_decision["agent"] == "opensearch_cost_agent":
    service_filter = "OpenSearch"
elif routing_decision["agent"] == "ec2_cost_agent":
    service_filter = "EC2"
elif routing_decision["agent"] == "s3_cost_agent":
    service_filter = "S3"
elif routing_decision["agent"] == "rds_cost_agent":
    service_filter = "RDS"
elif routing_decision["agent"] == "bedrock_cost_agent":
    service_filter = "Bedrock"
elif routing_decision["agent"] == "lambda_cost_agent":
    service_filter = "Lambda"

cost_data = cost_agent.get_last_7_days_cost(service_filter=service_filter)
    cost_summary = summary_service.summarize(cost_data)

    return {
        "user_query": request.user_query,
        "routing_decision": routing_decision,
        "cost_summary": cost_summary,
        "cost_data": cost_data,
        "message": "Cost Explorer Agent fetched and summarized real AWS cost data."
    }
